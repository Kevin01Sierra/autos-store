# Cadena de conexión del pooler de Supabase (modo transaction, puerto 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# URL del proyecto Supabase, usada para validar los JWT con su JWKS.
SUPABASE_URL=https://<ref>.supabase.co
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
# Secreto que debe enviar el job programado que sincroniza datos de mercado.
CRON_SECRET=change-me
# Fuente Socrata (datos.gov.co): parque automotor de Risaralda (ver docs/adr/0004).
MARKET_DATASET_URL=https://www.datos.gov.co/resource/x9pp-pcn5.json
MARKET_FIELD_BRAND=marca
MARKET_FIELD_MODEL=linea
# Sin color en este conjunto; defínelo solo si la fuente lo publica.
# MARKET_FIELD_COLOR=color
MARKET_FIELD_PERIOD=modelo
# year: la columna es un año (año modelo). date: fecha que se agrupa por mes.
MARKET_PERIOD_TYPE=year
MARKET_WHERE=clase in('AUTOMOVIL','CAMIONETA','CAMPERO') AND modelo >= 2018
PORT=3000
