  "cards": [
    {
      "dot": "cyan",
      "title": "Dominios",
      "items": [
        "Catálogo e inventario separan lo que es un modelo (Chevrolet Spark) de cada unidad a la venta, con su color, año y stock.",
        "vehicle_prices guarda el historial: un índice único parcial garantiza un solo precio vigente (valid_to is null) por vehículo."
      ]
    },
    {
      "dot": "amber",
      "title": "Mercado, a propósito sin llaves",
      "items": [
        "market_stats copia datos externos del RUNT con marca y modelo en texto; no apunta a models porque el mercado incluye miles de modelos que la tienda no vende.",
        "sales_stats es una vista materializada (sin llaves foráneas) que suma ventas no canceladas por modelo y color."
      ]
    },
    {
      "dot": "rose",
      "title": "Integridad",
      "items": [
        "on delete restrict en order_items y orders: no se puede borrar un vehículo o cliente con compras; los vehículos se archivan.",
        "Restricciones check: stock >= 0, cantidades > 0, precios > 0 y estados válidos."
      ]
    }
  ]
}