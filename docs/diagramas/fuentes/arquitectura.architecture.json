  "cards": [
    { "dot": "cyan", "title": "Despliegue", "items": [
      "Monorepo pnpm + Turborepo con dos proyectos de Vercel: rueda-autos (web) y autos-store-api (API).",
      "La API corre como una única función serverless que arranca Nest la primera vez y reutiliza la instancia.",
      "Cada PR genera previews en Vercel y pasa por CI: lint, tipos, pruebas, build y Playwright."
    ] },
    { "dot": "rose", "title": "Seguridad", "items": [
      "La API valida cada JWT contra el JWKS público de Supabase y lee el rol en profiles.",
      "RLS: catálogo y mercado son de lectura pública; las escrituras solo pasan por la API.",
      "POST /market/sync exige el encabezado x-cron-secret, comparado en tiempo constante."
    ] },
    { "dot": "amber", "title": "Datos de mercado", "items": [
      "Cada lunes el cron llama a la API, que consulta el parque automotor del RUNT y reemplaza market_stats.",
      "Otro job hace ping a /api/health cada 3 días para que Supabase no pause el proyecto."
    ] }
  ]
